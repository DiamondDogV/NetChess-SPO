@{
    Layout = "_Layout";
    ViewData["Title"] = "Registration";
}

@model UserModel
<link href="~/css/simpleform.css" rel="stylesheet" />
<section class="main-section">
    <div class="br-class" id="brdiv">
    </div>
    <form class="reg-form" asp-controller="Login" asp-action="CreateNewUser" asp-area="">
        <label asp-for="Login">Логин</label>
        <input asp-for="Login" type="text" />
        <span class="error-span" asp-validation-for="Login"></span>

        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" />
        <span class="error-span" asp-validation-for="Email"></span>

        <label asp-for="DisplayName">Имя которое будет показываться другим игрокам</label>
        <input asp-for="DisplayName" type="text" value="" />
        <span class="error-span" asp-validation-for="DisplayName"></span>

        <label asp-for="Password">Пароль</label>
        <input asp-for="Password" type="password" />
        <span class="error-span" asp-validation-for="Password"></span>

        <button id="submit-bt" type="submit">Зарегистрироваться</button>
        <a class="form-a" asp-controller="Login" asp-action="Login">Войти</a>
    </form>
</section>
<script src="~/js/loginforms.js"></script>