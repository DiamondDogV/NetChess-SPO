@using Chess.Domain.Entities
@using static Chess.Domain.Enums.Enums
@model Chess.Models.GameViewModel

@{
    ViewData["Title"] = "Игра: " + Model.RoomName;
}

<div class="game-page">

    <div class="info-panel">
        <a href="/" class="btn-back">Назад</a>

        <div class="chess-room-title">
            <span>Название комнаты:</span>
            @Model.RoomName
        </div>
    </div>

    <div class="chess-board">
        @{
            int startRow = Model.IsWhite ? 0 : 7;
            int endRow = Model.IsWhite ? 8 : -1;
            int rowStep = Model.IsWhite ? 1 : -1;

            int startCol = Model.IsWhite ? 0 : 7;
            int endCol = Model.IsWhite ? 8 : -1;
            int colStep = Model.IsWhite ? 1 : -1;
        }

        @for (int row = startRow; row != endRow; row += rowStep)
        {
            for (int col = startCol; col != endCol; col += colStep)
            {
                string cellColorClass = (row + col) % 2 == 0 ? "cell-light" : "cell-dark";

                var piece = Model.Board[row, col];
                string pieceSymbol = "";
                string pieceColorClass = "";

                if (piece != null && piece.ChessType != CMT.None)
                {
                    pieceColorClass = piece.IsBlack ? "piece-black" : "piece-white";

                    switch (piece.ChessType)
                    {
                        case CMT.King: pieceSymbol = "♚"; break;
                        case CMT.Ferz: pieceSymbol = "♛"; break;
                        case CMT.Roock: pieceSymbol = "♜"; break;
                        case CMT.Slon: pieceSymbol = "♝"; break;
                        case CMT.Knight: pieceSymbol = "♞"; break;
                        case CMT.Pawn: pieceSymbol = "♟"; break;
                    }
                }

                <div class="cell @cellColorClass" onclick="onCellClick(@row, @col)">
                    @if (!string.IsNullOrEmpty(pieceSymbol))
                    {
                        <span class="piece @pieceColorClass">@pieceSymbol</span>
                    }
                </div>
            }
        }
    </div>

</div>

<script>
    const ROOM_TOKEN = '@Model.Token';
    const HEARTBEAT_MS = 5000;

    async function heartbeat() {
        try {
            await fetch('/Game/Heartbeat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: ROOM_TOKEN })
            });
        } catch (e) { }
    }

    heartbeat();
    const hbTimer = setInterval(heartbeat, HEARTBEAT_MS);

    window.addEventListener('beforeunload', () => {
        navigator.sendBeacon('/Game/CloseRoom',
            new Blob([JSON.stringify({ token: ROOM_TOKEN })], { type: 'application/json' }));
    });

    function onCellClick(row, col) {
        console.log("Клик по клетке: row=" + row + ", col=" + col);
    }
</script>