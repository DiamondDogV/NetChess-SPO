@{
}
@model ChessBoardModel

<div class="game-page">

    <div class="info-panel">
        <a href="/" class="btn-back">Назад</a>

        <div class="chess-room-title">
            <span>Название комнаты:</span>
            @Model.RoomName
        </div>
    </div>

    <div class="chess-board">
        @{
            // Определяем начало и конец циклов в зависимости от цвета
            int startRow = Model.IsWhite ? 0 : 7;
            int endRow = Model.IsWhite ? 8 : -1;
            int rowStep = Model.IsWhite ? 1 : -1;

            int startCol = Model.IsWhite ? 0 : 7;
            int endCol = Model.IsWhite ? 8 : -1;
            int colStep = Model.IsWhite ? 1 : -1;
        }

        @for (int row = startRow; row != endRow; row += rowStep)
        {
            for (int col = startCol; col != endCol; col += colStep)
            {
                // Цвет клетки зависит от её реальных координат на доске (row + col)
                string cellColorClass = (row + col) % 2 == 0 ? "cell-light" : "cell-dark";

                string pieceCode = Model.Board[row, col];
                string pieceSymbol = "";
                string pieceColorClass = "";

                if (pieceCode != null)
                {
                    if (pieceCode.StartsWith("w_")) pieceColorClass = "piece-white";
                    else if (pieceCode.StartsWith("b_")) pieceColorClass = "piece-black";

                    char pieceType = pieceCode[2];
                    switch (pieceType)
                    {
                        case 'k': pieceSymbol = "♚"; break;
                        case 'q': pieceSymbol = "♛"; break;
                        case 'r': pieceSymbol = "♜"; break;
                        case 'b': pieceSymbol = "♝"; break;
                        case 'n': pieceSymbol = "♞"; break;
                        case 'p': pieceSymbol = "♟"; break;
                    }
                }

                <div class="cell @cellColorClass">
                    @if (!string.IsNullOrEmpty(pieceSymbol))
                    {
                        <span class="piece @pieceColorClass">@pieceSymbol</span>
                    }
                </div>
            }
        }
    </div>

</div>